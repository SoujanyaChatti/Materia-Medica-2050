---
import Base from '../layouts/Base.astro';
import { getAllSpecies, getLineage, getMeta, getSpeciesList } from '../lib/data';
import { QUADRANTS, toAction } from '../lib/action';
import { COMPONENT_LABELS } from '../lib/format';
import { href, plantHref } from '../lib/url';
import type { RiskComponents } from '../lib/types';

const meta = getMeta();
const species = getSpeciesList();
const steps: ['h' | 'm', string, string][] = [
  ['h', 'Read the source', "De Materia Medica chapters and Greek plant names (Wellmann ed.)"],
  ['h', 'Identify modern taxa', 'Literature-based match, rated Certain · Probable · Disputed'],
  ['m', 'Gather occurrences', 'GBIF records, cleaned, thinned to ~1 km, published only as ~10 km cells'],
  ['m', 'Climate layers', `Baseline and 2041–2060 under SSP2-4.5 and SSP5-8.5, ${meta.gcms.length} climate models`],
  ['m', 'Model habitat', 'MaxEnt + random-forest ensemble, target-group background'],
  ['m', 'Score risk', 'Range loss, endemism, conservation status, harvest pressure'],
  ['m', 'Find cultivation zones', 'Suitable in 2050, on farmland, outside Natura 2000, away from wild populations'],
  ['m', 'Turn results into action', 'Decision rules, grower index per 10 km cell, identification timeline'],
];
const full = getAllSpecies();
const harvest = full.map((s) => s.risk.components.harvest);
const hMin = Math.min(...harvest), hMax = Math.max(...harvest);
const actions = full.map(toAction);
const lin = getLineage();
const nClaims = lin.reduce((n, p) => n + p.claims.length, 0);
const v = meta.versions;
const sources: [string, string, string, string][] = [
  ['De Materia Medica, Wellmann ed. (1906–14)', 'Greek names, book, chapter, opening words', 'Public domain (Wellmann d. 1933); First1KGreek digitisation CC BY-SA 4.0 for some excerpts', 'archive.org scans'],
  ['Sprengel 1830 commentary; Osbaldeston 2000', 'Ancient-to-modern taxon matches', 'Cited per plant; not redistributed', 'see each plant'],
  ['GBIF occurrence download', 'Occurrence cells', 'Cite the download DOI; per-record CC0 / CC BY / CC BY-NC', meta.gbif_doi ? `DOI ${meta.gbif_doi}` : '—'],
  ['GBIF Backbone · Catalogue of Life · WCVP (Kew)', 'Accepted names', 'CC BY 4.0', '2026'],
  ['WorldClim 2.1 + CMIP6 (2041–2060)', 'Baseline and 2050 climate', 'Academic, non-commercial use; no redistribution of the data', `${v.climate ?? 'WorldClim 2.1'} · ${meta.gcms.join(', ')}`],
  ['Copernicus DEM GLO-90', 'Elevation, slope', 'Free licence; mandatory notice below', v.dem ?? 'GLO-90'],
  ['Vascular Plants of Greece checklist', 'Native status, endemism', 'Cited as facts', 'Dimopoulos et al. 2013, 2016'],
  ['IUCN Red List API v4', 'Conservation status', 'IUCN terms of use (non-commercial)', v.iucn ?? '2026'],
  ['Natura 2000 (EEA / DG ENV)', 'Protected-area boundaries', 'CC BY 4.0', v.natura2000 ?? 'end-2024'],
  ['CORINE Land Cover 2018 (Copernicus)', 'Agricultural and transitional land', 'Full, free and open (Reg. 1159/2013)', v.corine ?? 'CLC2018 100 m'],
  ['OpenStreetMap (Geofabrik)', 'Roads and settlements for the harvest proxy', 'ODbL 1.0', v.osm ?? 'Greece extract'],
  ['EMA herbal monographs (HMPC)', 'Regulatory status only', '© EMA; reuse with acknowledgement', 'accessed Nov 2026'],
  ['Natural Earth via world-atlas', 'Basemap outlines', 'Public domain; world-atlas ISC © Michael Bostock', '1:50m'],
];
const weights = meta.risk_weights;
const order: (keyof RiskComponents)[] = ['range_loss', 'harvest', 'status', 'endemism'];
const sens = order.filter((k) => meta.sensitivity.one_at_a_time[k]).map((k) => ({ k, ...meta.sensitivity.one_at_a_time[k]! }));
const pos = (v: number) => `${Math.max(0, Math.min(100, ((v - 0.5) / 0.5) * 100))}%`;
const topK = meta.sensitivity.top_k_unchanged;
---
<Base title="Methods and limitations" current="methods">
  <div class="page flex flex-col gap-14 pb-16 pt-10">
    <div class="flex max-w-[780px] flex-col gap-2">
      <h1 class="h-display m-0 text-[clamp(34px,4vw,48px)]">Methods and limitations</h1>
      <p class="m-0 text-[17px] text-muted">From a 1st-century text to a 2050 habitat map and an action plan in eight steps. Each step names its sources and its main uncertainty.</p>
      <nav aria-label="On this page" class="flex flex-wrap gap-x-4.5 gap-y-1 pt-2 text-[15px]">
        <a href="#pipeline">Pipeline</a><a href="#sources">Data &amp; licences</a><a href="#validation">Validation</a><a href="#sensitivity">Sensitivity</a><a href="#action">From results to action</a><a href="#limits">Limitations</a><a href="#reproduce">Reproduce</a><a href="#team">Team</a>
      </nav>
    </div>

    <section id="pipeline" aria-labelledby="h-pipe" class="flex flex-col gap-4.5">
      <h2 id="h-pipe" class="h-section">Pipeline</h2>
      <ol class="m-0 flex list-none flex-wrap items-stretch gap-3 p-0">
        {steps.map(([k, title, detail], i) => (
          <li class="flex flex-[1_1_150px] flex-col gap-1.5 rounded-md border border-rule p-3.5"
            style={`background: var(${k === 'h' ? '--sunk' : '--surface'}); border-top: 3px solid var(${k === 'h' ? '--ochre' : '--sage'})`}>
            <div class="flex items-center justify-between"><span class="text-[12px] font-bold tracking-[0.08em]" style={`color: var(${k === 'h' ? '--ochre' : '--sage'})`}>STEP {i + 1}</span><span aria-hidden="true" class="text-muted">{i < steps.length - 1 ? '▸' : ''}</span></div>
            <div class="font-semibold leading-tight">{title}</div>
            <div class="text-[13px] text-muted">{detail}</div>
          </li>
        ))}
      </ol>
      <p class="m-0 text-[14px] text-muted"><span aria-hidden="true" class="mr-1.5 inline-block h-2.5 w-2.5 bg-ochre"></span>Historical sources <span aria-hidden="true" class="ml-4 mr-1.5 inline-block h-2.5 w-2.5 bg-sage"></span>Modern data and models. Steps run left to right; the arrow ▸ marks the flow. Each step is a script in <code class="font-mono">pipeline/</code> with cached, seeded outputs.</p>
    </section>

    <section id="sources" aria-labelledby="h-src" class="flex flex-col gap-3.5">
      <h2 id="h-src" class="h-section">Data sources and licences</h2>
      <div class="card-data overflow-x-auto">
        <table class="w-full min-w-[760px] border-collapse text-[15px]">
          <thead><tr class="border-b-2 border-ink text-left"><th scope="col" class="px-4 py-3 text-[13px]">Source</th><th scope="col" class="px-2 py-3 text-[13px]">Used for</th><th scope="col" class="px-2 py-3 text-[13px]">Licence / terms</th><th scope="col" class="py-3 pl-2 pr-4 text-[13px]">Version</th></tr></thead>
          <tbody>
            {sources.map(([s, u, l, v]) => <tr class="border-b border-data-rule align-top"><td class="px-4 py-3 font-semibold">{s}</td><td class="px-2 py-3">{u}</td><td class="px-2 py-3">{l}</td><td class="py-3 pl-2 pr-4 text-muted">{v}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="flex max-w-[900px] flex-col gap-1.5 text-[13px] text-muted">
        <p class="m-0"><strong class="text-ink">Climate.</strong> Fick S.E. &amp; Hijmans R.J. 2017. WorldClim 2: new 1 km spatial resolution climate surfaces for global land areas. <em>Int. J. Climatol.</em> 37: 4302–4315. Future climate is CMIP6 output from {meta.gcms.join(', ')}, downscaled by WorldClim. We acknowledge the World Climate Research Programme, which coordinated CMIP6, the modelling groups that produced and made available their output, and the Earth System Grid Federation and its funding agencies. No WorldClim raster is redistributed here.</p>
        <p class="m-0"><strong class="text-ink">Elevation.</strong> Produced using Copernicus WorldDEM-90 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA; all rights reserved.</p>
        <p class="m-0"><strong class="text-ink">Land cover.</strong> Generated using European Union's Copernicus Land Monitoring Service information; <a href="https://doi.org/10.2909/960998c1-1870-4e82-8051-6485205ebbac">doi:10.2909/960998c1</a>. Modified: reclassified and averaged to the climate grid.</p>
        <p class="m-0"><strong class="text-ink">Roads and settlements.</strong> Contains information from <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, available under the Open Database Licence. The derived accessibility layer is not published; the code that makes it is.</p>
        <p class="m-0"><strong class="text-ink">Protected areas.</strong> Natura 2000 (vector), end-2024 release © European Environment Agency / DG ENV, CC BY 4.0, rasterised to the climate grid.</p>
        <p class="m-0">Full licence notes, with the terms pages we read: <a href="https://github.com/SoujanyaChatti/Materia-Medica-2050/blob/main/DATA_LICENSES.md">DATA_LICENSES.md</a>.</p>
      </div>
    </section>

    <div class="grid items-start gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))]">
      <section id="validation" aria-labelledby="h-val" class="flex flex-col gap-3.5">
        <h2 id="h-val" class="h-section">Validation</h2>
        <p class="m-0 text-[15px] text-muted">5-fold spatial block cross-validation (blocks ≈ 25 km). Values are mean ± SD across folds. Every model is also compared with a <strong>distance-only baseline</strong> on the same folds: a held-out point scores higher the closer it is to a training record. Grade: <strong>standard</strong> = ≥ 30 records, AUC ≥ 0.75 and above the baseline; <strong>data gap</strong> = fewer than 10 records; otherwise <strong>low</strong>. {species.filter((s) => s.model?.grade === 'standard').length} of {species.length} models are standard grade and {species.filter((s) => s.model?.beats_baseline).length} of {species.length} beat the baseline, several only narrowly (Cretan dittany: {species.find((s) => s.slug === 'origanum-dictamnus')?.model?.auc_mean.toFixed(3)} vs {species.find((s) => s.slug === 'origanum-dictamnus')?.model?.baseline_auc?.toFixed(3)}). For narrow endemics, being near known records predicts held-out records almost as well as climate does.</p>
        <div class="card-data overflow-x-auto">
          <table class="w-full min-w-[440px] border-collapse text-[15px]">
            <thead><tr class="border-b-2 border-ink text-left"><th scope="col" class="px-4 py-2.5 text-[13px]">Species</th><th scope="col" class="px-2 py-2.5 text-right text-[13px]">AUC</th><th scope="col" class="px-2 py-2.5 text-right text-[13px]">Baseline AUC</th><th scope="col" class="px-2 py-2.5 text-right text-[13px]">Boyce</th><th scope="col" class="px-2 py-2.5 text-right text-[13px]">Records</th><th scope="col" class="py-2.5 pl-2 pr-4 text-[13px]">Model</th></tr></thead>
            <tbody>
              {species.map((s) => {
                const ok = (s.model?.grade ?? (s.model && s.model.auc_mean >= 0.75 && !s.low_confidence_model ? 'standard' : 'low')) === 'standard';
                return (
                  <tr class="border-b border-data-rule">
                    <td class="px-4 py-2.5"><a href={plantHref(s.slug)} class="text-ink"><em class="font-serif text-[17px]">{s.accepted_name.split(' ').slice(0, 2).join(' ')}</em></a></td>
                    <td class="px-2 py-2.5 text-right">{s.model ? `${s.model.auc_mean.toFixed(2)} ± ${s.model.auc_sd.toFixed(2)}` : '—'}</td>
                    <td class="px-2 py-2.5 text-right">{s.model?.baseline_auc !== undefined ? s.model.baseline_auc.toFixed(2) : '—'}</td>
                    <td class="px-2 py-2.5 text-right">{s.model ? s.model.boyce_mean.toFixed(2) : '—'}</td>
                    <td class="px-2 py-2.5 text-right">{s.records_clean ?? '—'}</td>
                    <td class="py-2.5 pl-2 pr-4">{ok
                      ? <span class="rounded-full border border-sage px-2 text-[13px] font-semibold text-sage">Standard</span>
                      : <span class="rounded-full border border-warn-border px-2 text-[13px] font-semibold text-warn">{s.model?.grade === 'data gap' ? 'Data gap' : 'Low'}</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section id="sensitivity" aria-labelledby="h-sens" class="flex flex-col gap-3.5">
        <h2 id="h-sens" class="h-section">Sensitivity of the risk ranking</h2>
        <p class="m-0 text-[15px] text-muted">Weights: {order.map((k) => `${COMPONENT_LABELS[k].toLowerCase()} ${weights[k].toFixed(2)}`).join(' · ')}. Each weight was varied ±{Math.round((meta.sensitivity.perturbation ?? 0.5) * 100)}% while the others rescale. Bars show the 5–95% range of rank agreement (Kendall's τ) with the baseline ranking; the dot is the median over {meta.sensitivity.draws.toLocaleString('en-GB')} draws.</p>
        <figure class="card-data m-0 flex flex-col gap-3.5 px-5 pb-3.5 pt-5">
          {sens.map((r) => (
            <div class="grid grid-cols-[minmax(110px,160px)_minmax(0,1fr)] items-center gap-3">
              <div class="text-[14px] font-semibold leading-tight">{COMPONENT_LABELS[r.k]} weight<div class="text-[13px] font-normal text-muted">τ {r.tau_median.toFixed(2)} ({r.tau_lo.toFixed(2)}–{r.tau_hi.toFixed(2)})</div></div>
              <div role="img" aria-label={`Kendall tau median ${r.tau_median.toFixed(2)}, range ${r.tau_lo.toFixed(2)} to ${r.tau_hi.toFixed(2)}`} class="relative h-5 rounded-sm bg-sunk">
                <div class="absolute top-1.5 h-2 rounded-[1px] bg-ink" style={`left: ${pos(r.tau_lo)}; width: calc(${pos(r.tau_hi)} - ${pos(r.tau_lo)})`}></div>
                <div class="absolute top-[3px] -ml-1.5 box-border h-3 w-3 rounded-full border-2 border-ink bg-data" style={`left: ${pos(r.tau_median)}`}></div>
              </div>
            </div>
          ))}
          <div class="grid grid-cols-[minmax(110px,160px)_minmax(0,1fr)] gap-3"><span></span><div class="flex justify-between text-[12px] text-muted"><span>τ 0.50</span><span>0.75</span><span>1.00 (identical)</span></div></div>
          <figcaption class="border-t border-data-rule pt-2.5 text-[14px] text-muted">The top-{meta.sensitivity.top_k} species are unchanged in {topK.median}% ({topK.min}–{topK.max}%) of draws.{meta.sensitivity.top10_overlap_without_disputed !== undefined && ` Top-10 overlap with disputed identifications removed: ${Math.round(meta.sensitivity.top10_overlap_without_disputed * 100)}%.`}</figcaption>
        </figure>
        <p class="m-0 text-[15px]">Weights move the ranking far less than identification does. Modelling each disputed plant as the rival species its sources name moves several plants in or out of the top 10: <a href={href('identification/')} class="font-semibold">see the identification sensitivity</a>.</p>
      </section>
    </div>

    <section id="action" aria-labelledby="h-act" class="flex flex-col gap-3.5">
      <h2 id="h-act" class="h-section">From results to action (stage 8)</h2>
      <p class="m-0 max-w-[900px] text-[15px] text-muted"><code class="font-mono">pipeline/08_action_layers.py</code> uses only the Python standard library and reads only what stage 7 exported, so anyone can re-run it without the modelling environment (<code class="font-mono">make action</code>). It adds no new modelling.</p>
      <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))]">
        <div class="card-data flex flex-col gap-1.5 p-4.5">
          <h3 class="m-0 text-[17px]">Decision rules</h3>
          <ul class="m-0 flex flex-col gap-1 pl-4.5 text-[14px]">
            {Object.entries(QUADRANTS).map(([k, q]) => <li><strong>{q.title}</strong> ({actions.filter((a) => a.quadrant === k).length}): {q.rule}.</li>)}
          </ul>
          <p class="m-0 text-[13px] text-muted">Plants with a disputed identification or a low-confidence model are marked "resolve data first" in every lane. <a href={href('act/')}>Open the action plan</a>.</p>
        </div>
        <div class="card-data flex flex-col gap-1.5 p-4.5">
          <h3 class="m-0 text-[17px]">Grower index</h3>
          <p class="m-0 text-[14px]">For every ~10 km cell, the plants whose 2050 cultivation zone covers it. Zones are unions of whole grid cells, so a cell-centre test is exact. <strong>Validated:</strong> the per-cell counts match stage 7's independent raster counts in every cell (0 mismatches). SSP2-4.5 only, as stage 7 exports zone outlines for that scenario.</p>
        </div>
        <div class="card-data flex flex-col gap-1.5 p-4.5">
          <h3 class="m-0 text-[17px]">Identification timeline</h3>
          <p class="m-0 text-[14px]">{nClaims} claims parsed from the curated identification table: who proposed, preferred or rejected each candidate, with the authority who reports it ("Matthiolus, rejected by Sprengel"). Dates are each authority's main work, approximate and used only for ordering.</p>
        </div>
        <div class="card-data flex flex-col gap-1.5 p-4.5">
          <h3 class="m-0 text-[17px]">Risk weight lab</h3>
          <p class="m-0 text-[14px]">Recomputes the stage 5 score in the browser from the exported components. With the published weights it reproduces every published score to within 0.001 and the published ranking exactly; Kendall's τ is computed the same way as above.</p>
        </div>
      </div>
    </section>

    <section id="limits" aria-labelledby="h-lim" class="grid gap-x-10 gap-y-4 border-t-2 border-ochre pt-5 [grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))]">
      <h2 id="h-lim" class="h-section col-span-full">Limitations</h2>
      <div><h3 class="m-0 mb-1 text-[17px]">Identification is interpretation</h3><p class="m-0 text-muted">Matching an ancient name to a modern species is a scholarly judgement. "Disputed" plants may describe the wrong taxon entirely.</p></div>
      <div><h3 class="m-0 mb-1 text-[17px]">Suitability is not presence</h3><p class="m-0 text-muted">Correlative models assume equilibrium with climate and ignore dispersal, soils, grazing and land use. Range change assumes plants can reach every newly suitable cell in Greece, so gains are optimistic; a suitable cell in 2050 may never be colonised.</p></div>
      <div><h3 class="m-0 mb-1 text-[17px]">Sampling bias</h3><p class="m-0 text-muted">Occurrence records cluster near roads and well-known mountains. Target-group background and thinning reduce but do not remove this.</p></div>
      <div><h3 class="m-0 mb-1 text-[17px]">Harvest pressure is a proxy, and it saturates</h3><p class="m-0 text-muted">Estimated from accessibility (range within 2 km of roads or villages) plus a documented wild-harvest flag, not measured collection. In Greece's dense road network almost every range is accessible: the component spans only {hMin.toFixed(2)}–{hMax.toFixed(2)} across species, so it barely separates plants and its weight hardly moves the ranking. Measured collection data (permits, trade volumes) would fix this.</p></div>
      <div><h3 class="m-0 mb-1 text-[17px]">Coarse grid</h3><p class="m-0 text-muted">~{meta.cell_km} km cells protect rare plants from collectors but hide microrefugia such as gorges and north slopes.</p></div>
      <div><h3 class="m-0 mb-1 text-[17px]">No health claims</h3><p class="m-0 text-muted">This project maps plants. It makes no statement about the safety or effect of any plant or preparation. Results are hypotheses for conservation planning, not prescriptions.</p></div>
    </section>

    <div class="grid items-start gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))]">
      <section id="reproduce" aria-labelledby="h-rep" class="flex flex-col gap-3">
        <h2 id="h-rep" class="h-section">How to reproduce</h2>
        <pre class="m-0 overflow-x-auto whitespace-pre rounded-md px-5 py-4.5 font-mono text-[13.5px] leading-[1.7]" style="background:#1D231F;color:#ECE6D7">git clone https://github.com/SoujanyaChatti/Materia-Medica-2050.git
cd Materia-Medica-2050
make env        # conda env from environment.yml
make data       # species list, GBIF, WorldClim, DEM
make models     # SDMs + spatially blocked CV
make risk       # risk score, sensitivity, cultivation
make web        # export + JSON Schema validation + stage 8
make action     # stage 8 only (stdlib Python, no GIS stack)
make site       # builds the Astro site
# or simply: make all</pre>
        <p class="m-0 text-[14px] text-muted">Fixed random seeds; GBIF download DOI and all versions recorded in <code class="font-mono">data/manifest.yml</code>. Build {meta.build_date}{meta.gbif_doi ? ` · GBIF DOI ${meta.gbif_doi}` : ''}.</p>
        <a href="https://github.com/SoujanyaChatti/Materia-Medica-2050" class="btn-primary w-fit">View the code on GitHub</a>
      </section>

      <section id="team" aria-labelledby="h-team" class="flex flex-col gap-3">
        <h2 id="h-team" class="h-section">Team</h2>
        <ul class="m-0 grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fill,minmax(200px,1fr))]">
          <li class="card-surface p-3.5"><div class="font-semibold">Soujanya Chatti</div><div class="text-[14px] text-muted">Research, modelling and web</div></li>
        </ul>
        <p class="m-0 text-[14px] text-muted">Cite as: Chatti, S. (2026). <em>Dioscorides' Plants, Then and Now</em>. EthnoHack 2026. <a href="https://github.com/SoujanyaChatti/Materia-Medica-2050">github.com/SoujanyaChatti/Materia-Medica-2050</a>{meta.gbif_doi ? `. Occurrence data: GBIF.org GBIF Occurrence Download https://doi.org/${meta.gbif_doi}` : ''}.</p>
      </section>
    </div>
  </div>
</Base>
