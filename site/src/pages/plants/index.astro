---
import Base from '../../layouts/Base.astro';
import PlantExplorer from '../../components/PlantExplorer';
import WeightLab, { type LabRow } from '../../components/WeightLab';
import { getAllSpecies, getMeta, getSpeciesList } from '../../lib/data';

const meta = getMeta();
const rows = getSpeciesList();
const lab: LabRow[] = getAllSpecies().map((s) => ({
  slug: s.slug, name: s.common_name_en, latin: s.accepted_name.split(' ').slice(0, 2).join(' '), rank: s.risk.rank,
  disputed: s.identification.confidence === 'disputed', components: s.risk.components,
}));
---
<Base title="Plants" current="plants" sampleNote={`${rows.length} illustrative species; values are placeholders for design review.`}>
  <div class="page flex flex-col gap-6 pb-16 pt-10">
    <div class="flex flex-col gap-1.5">
      <h1 class="h-display m-0 text-[clamp(34px,4vw,48px)]">The plants</h1>
      <p class="m-0 max-w-[720px] text-muted">Every species from <em>De Materia Medica</em> we could match to a modern taxon that grows wild in Greece, ranked by combined risk. Range changes are medians with the spread across {meta.gcms.length} climate models. <a href="#lab">Re-weigh the ranking yourself</a>.</p>
    </div>
    <PlantExplorer client:load rows={rows} total={meta.n_species} />
    <div id="lab" class="scroll-mt-6 pt-6"><WeightLab client:visible rows={lab} published={meta.risk_weights} /></div>
  </div>
</Base>
