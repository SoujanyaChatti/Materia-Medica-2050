---
import Base from '../layouts/Base.astro';
import { getAllSpecies, getIdentification, getLineage, getMeta, getPhotos, getSpecies, getSpeciesList } from '../lib/data';
import { toAction } from '../lib/action';
import { href, plantHref } from '../lib/url';
import { changeText, riskLabel } from '../lib/format';
import { PlantFlags, RiskTag } from '../components/Badges';
import { PlantPhoto } from '../components/PlantPhoto';
import { MapLegend } from '../components/MapLegend';
import { RangeMap } from '../components/RangeMap';
import { Whisker } from '../components/UncertainValue';
import { IconArrow } from '../components/icons';

const meta = getMeta();
const list = getSpeciesList();
const top = list.slice(0, 5);
const head = getSpecies(meta.headline_slug);
const headChange = changeText(head.range_change_pct.ssp245);
const med = meta.summary.median_range_change_ssp245;
const medText = med ? changeText(med) : null;
const n = meta.n_species;
const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const nWord = n <= 10 ? words[n] : n === 32 ? 'Thirty-two' : String(n);
const latin = (s: string) => s.split(' ').slice(0, 2).join(' ');
const actions = getAllSpecies().map(toAction);
const losers = actions.filter((a) => a.allAgreeLoss);
const nCult = actions.filter((a) => a.cultKm2 > 0).length;
const lin = getLineage();
const nClaims = lin.reduce((s, p) => s + p.claims.length, 0);
const firstYear = Math.min(...lin.flatMap((p) => p.claims.map((c) => c.year)));
const lossTop = losers.filter((a) => a.rank <= 10).length;
const idn = getIdentification();
const nameOf = Object.fromEntries(list.map((p) => [p.slug, p.common_name_en.split(' / ')[0]]));
const idMoves = idn?.summary.plants_moving_in_or_out_of_top10 ?? 0;
const idIn = (idn?.summary.plants_entering_top10_under_some_alternative ?? []).map((k) => nameOf[k] ?? k);
const idOut = (idn?.summary.plants_leaving_top10_under_some_alternative ?? []).map((k) => nameOf[k] ?? k);
const andList = (a: string[]) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);
const idFlip = idn?.summary.disputed_plants_whose_own_top10_status_can_change.length ?? 0;
const nDisputed = list.filter((p) => p.identification_confidence === 'disputed').length;
const firstAlt = (idn?.plants ?? []).flatMap((p) => p.candidates.filter((c) => c.rank === 1).map((c) => ({ plant: p.common_name_en, taxon: c.query_name, records: c.records, rank: p.published.rank })));
const headCult = head.cultivation_area_km2;
const headCultR = head.cultivation_area_km2_range;
const judges = [
  { t: 'The finding', d: 'Which plant Dioscorides meant changes the ranking.', h: '#finding' },
  { t: 'Cretan dittany', d: 'Rank 1, its range, its single farmland cell.', h: plantHref(head.slug) },
  { t: 'Identification', d: 'Every rival species, re-ranked with sources.', h: href('identification/') },
  { t: 'Methods', d: 'Data, validation, baseline, limits.', h: href('methods/') },
];
const ways = [
  { href: href('act/'), eyebrow: 'Decide', title: 'Action plan', text: `Which plants to protect, which to cultivate, and a grower finder that lists what a farmer could plant in any ~10 km cell by 2050.` },
  { href: href('names/'), eyebrow: 'Then', title: 'Names through time', text: `${nClaims} dated identifications since ${firstYear}: who matched each Greek name to which modern plant, and where scholars still disagree.` },
  { href: href('plants/#lab'), eyebrow: 'Test us', title: 'Risk weight lab', text: 'A ranking is a value judgement. Re-weigh climate, endemism, status and harvest, and watch the ranking move live.' },
  { href: href('map/'), eyebrow: 'Explore', title: 'Map explorer', text: 'Combined risk on a 10 km grid, cultivation hotspots and Natura 2000; select any area to list its plants.' },
];
---
<Base title="Home" current="home">
  <section class="page grid items-center gap-12 pb-[clamp(32px,4vw,56px)] pt-[clamp(40px,6vw,88px)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))]">
    <div class="flex flex-col gap-5">
      <div class="eyebrow text-ochre">EthnoHack 2026 · Ethnopharmacology research prototype</div>
      <h1 class="h-display m-0 text-[clamp(36px,4.6vw,60px)]">The plants that founded Western pharmacy, mapped then and now</h1>
      <p class="latin m-0 text-[clamp(20px,2vw,24px)] text-muted">What we stand to lose, and where to save it.</p>
      <p class="m-0 max-w-[560px] text-[17px]">Dioscorides compiled <em>De Materia Medica</em> in the 1st century CE; it shaped European pharmacy for more than 1,500 years. Many of its plants still grow wild in Greece. We model where {n} of them live today, where they could survive in 2050, and where they could be cultivated instead.</p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href={href('plants/')} class="btn-primary">Explore the plants <IconArrow /></a>
        <a href={href('methods/')} class="btn-secondary">How we model it</a>
      </div>
    </div>
    <figure class="m-0 grid grid-cols-2 overflow-hidden rounded-md border border-rule bg-data">
      <div class="flex flex-col items-center gap-2.5 border-r border-rule bg-sunk px-4 py-5">
        <div class="flex items-baseline justify-between gap-2 self-stretch">
          <div class="eyebrow text-[11px] tracking-[0.14em] text-ochre">Then</div>
          <div class="text-[12px] text-muted">Book {['', 'I', 'II', 'III', 'IV', 'V'][head.dioscorides.book]}, ch. {head.dioscorides.chapter}</div>
        </div>
        <div lang="grc" class="self-stretch font-serif text-[24px] text-ochre">{head.dioscorides.greek_name}</div>
        <PlantPhoto slug={head.slug} credit={getPhotos()[head.slug] ?? null} name={head.common_name_en} className="self-stretch" imgClass="aspect-[4/5]" />
      </div>
      <div class="flex flex-col gap-2.5 px-4 py-5">
        <div class="eyebrow text-[11px] tracking-[0.14em] text-sage">Now · 2050</div>
        <RangeMap client:visible mode="range" slug={head.slug} scenario="ssp245" layers={{ range: true, labels: false }}
          controls={false} chip="2050 · moderate" ariaLabel={`Map of Greece: modelled range of ${head.common_name_en} under 2050 moderate emissions.`} />
        <figcaption class="text-[13px] text-muted">{head.common_name_en}, modelled range under 2050 moderate emissions.</figcaption>
      </div>
    </figure>
  </section>

  <section aria-label="Project at a glance" class="border-y border-rule bg-surface">
    <dl class="page my-0 grid gap-x-8 gap-y-5 py-6 [grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))]">
      <div><dt class="text-[13px] text-muted">Species modelled</dt><dd class="m-0 text-[28px] font-semibold">{n}</dd></div>
      <div><dt class="text-[13px] text-muted">Climate futures</dt><dd class="m-0 text-[28px] font-semibold">2 <span class="text-[15px] font-normal text-muted">scenarios × {meta.gcms.length} climate models</span></dd></div>
      <div><dt class="text-[13px] text-muted">Lose wild habitat by 2050</dt><dd class="m-0 text-[28px] font-semibold">{losers.length} <span class="text-[15px] font-normal text-muted">of {n} · all {meta.gcms.length} models agree</span></dd></div>
      <div><dt class="text-[13px] text-muted">Candidate farmland by 2050</dt><dd class="m-0 text-[28px] font-semibold">{nCult} <span class="text-[15px] font-normal text-muted">plants · outside Natura 2000</span></dd></div>
      {nClaims > 0 && <div><dt class="text-[13px] text-muted">Historical identifications</dt><dd class="m-0 text-[28px] font-semibold">{nClaims} <span class="text-[15px] font-normal text-muted">claims since {firstYear}</span></dd></div>}
    </dl>
  </section>

  {idn && (
    <section id="finding" aria-labelledby="h-finding" class="page flex flex-col gap-3 pb-2 pt-12">
      <div class="eyebrow text-ochre">The finding</div>
      <h2 id="h-finding" class="h-section mt-0">{idMoves > 0 ? `Which plant Dioscorides meant moves ${idMoves} of ${n} plants in or out of the top 10` : `Rival identifications do not move any plant in or out of the top 10`}</h2>
      <p class="m-0 max-w-[860px] text-[17px]">{nDisputed} of our plants have disputed identifications. We modelled all {idn.summary.modelled} rival species that the cited scholarship names for them (another {idn.summary.data_gap} have too few records in Greece to model) with the same data, models and climate futures, and re-ranked all {n} plants once per alternative.{idIn.length > 0 && <> Depending on the identification, <strong>{andList(idIn)}</strong> {idIn.length === 1 ? 'enters' : 'enter'} the top 10{idOut.length > 0 && <> and <strong>{andList(idOut)}</strong> {idOut.length === 1 ? 'drops' : 'drop'} out</>}.</>} For {idFlip} of the {nDisputed} disputed plants, their own place in the top 10 depends on the identification.{firstAlt.map((a) => <> Modelled as <em>{a.taxon}</em>, {a.plant} would rank <strong>first</strong>, above dittany (published rank {a.rank}; that model rests on {a.records} records).</>)}</p>
      <a href={href('identification/')} class="inline-flex min-h-11 w-fit items-center font-semibold">See every rival identification, with its source</a>
    </section>
  )}

  <section aria-labelledby="h-dittany" class="page flex flex-col gap-3 pb-2 pt-10">
    <div class="eyebrow text-sage">The headline plant</div>
    <h2 id="h-dittany" class="h-section mt-0">{head.common_name_en} ranks first and has almost nowhere to be grown instead</h2>
    <p class="m-0 max-w-[860px] text-[17px]">Its identification is certain, it grows only in Greece, and under moderate emissions its climate range changes by <strong>{headChange.med}</strong> by 2050 ({headChange.lo} to {headChange.hi} across {meta.gcms.length} climate models). Candidate farmland for it in 2050: <strong>{headCult !== null ? `${Math.round(headCult)} km²` : 'none'}</strong>{headCultR && <> ({Math.round(headCultR.min)}–{Math.round(headCultR.max)} km²)</>}. Its model only just beats a distance-only baseline (AUC {head.model?.auc_mean.toFixed(3)} vs {head.model?.baseline_auc?.toFixed(3)}), so treat the map as a hypothesis.</p>
  </section>

  <section aria-labelledby="h-judges" class="page pb-2 pt-8">
    <div class="card-surface flex flex-col gap-3 border-2 border-ink p-5">
      <h2 id="h-judges" class="m-0 text-[20px] font-semibold">For judges: a 60-second path</h2>
      <ol class="m-0 grid list-none gap-3 p-0 [grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))]">
        {judges.map((j, i) => (
          <li class="flex flex-col gap-0.5"><a href={j.h} class="font-semibold">{i + 1}. {j.t}</a><span class="text-[14px] text-muted">{j.d}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="h-split" class="page flex flex-col gap-3 pb-2 pt-12">
    <div class="eyebrow text-ochre">Across all 32 plants</div>
    <h2 id="h-split" class="h-section mt-0">A split future, not a uniform decline</h2>
    <p class="m-0 max-w-[820px] text-[17px]">Under moderate emissions, <strong>{losers.length} of {n}</strong> plants lose wild habitat by 2050 in every climate model we ran, while {n - losers.length} keep or gain it{medText ? ` (median change across all plants ${medText.med})` : ''}. The losers are concentrated at the top of the risk ranking ({lossTop} of the top 10), and they include plants Greece is known for: {losers.slice(0, 4).map((a) => a.name.split(' / ')[0]).join(', ')}. Averages hide this, so we report each plant, with its spread across models.</p>
  </section>

  <section class="page flex flex-col gap-6 pb-6 pt-14">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="h-section">Most at risk</h2>
        <p class="m-0 mt-1 text-muted">Top {top.length} of {n} by combined risk score. Ranks are uncertain too; the interval comes from 1,000 random weightings.</p>
      </div>
      <a href={href('plants/')} class="inline-flex min-h-11 items-center font-semibold">All {n} plants</a>
    </div>
    <ol class="m-0 grid list-none gap-4 p-0 [grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr))]">
      {top.map((p) => {
        const c = changeText(p.range_change_pct.ssp245);
        return (
          <li class="card-surface flex flex-col gap-2.5 p-4.5">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[13px] text-muted">No. <strong class="text-[15px] text-ink">{p.risk.rank}</strong>{p.risk.rank_lo !== undefined && <span> ({p.risk.rank_lo}–{p.risk.rank_hi})</span>}</span>
              <RiskTag cls={p.risk.class} />
            </div>
            <div lang="grc" class="font-serif text-[24px] leading-[1.1] text-ochre">{p.greek_name}</div>
            <div>
              <div class="text-[17px] font-semibold">{p.common_name_en}</div>
              <div class="latin text-[16px] text-muted">{latin(p.accepted_name)}</div>
            </div>
            <PlantFlags confidence={p.identification_confidence} endemic={p.endemic_greece} lowConfidence={p.low_confidence_model} />
            <dl class="m-0 flex flex-col gap-2 border-t border-rule pt-2.5 text-[14px]">
              <div><dt class="text-[13px] text-muted">Risk score</dt><dd class="m-0"><strong class="text-[18px]">{p.risk.score.toFixed(2)}</strong>{p.risk.score_lo !== undefined && <span class="text-muted"> ({p.risk.score_lo.toFixed(2)}–{p.risk.score_hi!.toFixed(2)})</span>}</dd></div>
              <div><dt class="text-[13px] text-muted">Range change, 2050 moderate</dt>
                <dd class="m-0 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span><strong class="text-[18px]">{c.med}</strong> <span class="text-muted">({c.lo} to {c.hi})</span></span><Whisker interval={p.range_change_pct.ssp245} width={100} fill="var(--surface)" /></dd></div>
            </dl>
            <a href={plantHref(p.slug)} class="mt-auto inline-flex min-h-11 items-center font-semibold">View {p.common_name_en}<span class="sr-only">, risk {riskLabel(p.risk.class)}</span></a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="page flex flex-col gap-5 pb-6 pt-12">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="eyebrow text-sage">Headline plant</div>
        <h2 class="h-section mt-0.5">{head.common_name_en}, now and in 2050</h2>
        <p class="m-0 mt-1 text-muted"><em class="latin text-[18px]">{latin(head.accepted_name)}</em> · projected range change under moderate emissions <strong class="text-ink">{headChange.med}</strong> ({headChange.lo} to {headChange.hi})</p>
      </div>
      <a href={plantHref(head.slug)} class="inline-flex min-h-11 items-center font-semibold">Open the plant page</a>
    </div>
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))]">
      <figure class="m-0 flex flex-col gap-2">
        <RangeMap client:visible mode="range" slug={head.slug} scenario="now" layers={{ range: true, labels: true }}
          chip={meta.scenarios.now.title} ariaLabel={`Map of Greece: modelled current range of ${head.common_name_en}.`} tableHref={plantHref(head.slug) + '#range-table'} />
        <figcaption class="text-[14px] text-muted"><strong class="text-ink">Now.</strong> {meta.scenarios.now.description}</figcaption>
      </figure>
      <figure class="m-0 flex flex-col gap-2">
        <RangeMap client:visible mode="range" slug={head.slug} scenario="ssp245" layers={{ range: true, cult: true, labels: true }}
          chip={meta.scenarios.ssp245.title} ariaLabel={`Map of Greece: ${head.common_name_en} habitat kept, lost and gained by 2050 under moderate emissions, with candidate cultivation zones.`} tableHref={plantHref(head.slug) + '#range-table'} />
        <figcaption class="text-[14px] text-muted"><strong class="text-ink">2050, moderate emissions.</strong> Kept, lost and gained habitat, with candidate cultivation zones.</figcaption>
      </figure>
    </div>
    <MapLegend items={['kept', 'lost', 'gained', 'cult']} note="Occurrences aggregated to ~10 km cells; exact locations are withheld to protect wild populations." />
  </section>

  <section aria-labelledby="h-ways" class="page flex flex-col gap-5 pb-6 pt-10">
    <h2 id="h-ways" class="h-section">Ways in</h2>
    <ul class="m-0 grid list-none gap-4 p-0 [grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))]">
      {ways.map((w) => (
        <li class="card-surface flex flex-col gap-2 p-5">
          <div class="eyebrow text-sage">{w.eyebrow}</div>
          <h3 class="m-0 font-serif text-[24px] font-medium">{w.title}</h3>
          <p class="m-0 text-[15px] text-muted">{w.text}</p>
          <a href={w.href} class="mt-auto inline-flex min-h-11 items-center font-semibold">Open {w.title.toLowerCase()} <span aria-hidden="true">&nbsp;→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="page pb-18 pt-12">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-md border border-rule bg-sunk p-[clamp(28px,4vw,48px)]">
      <div class="max-w-[640px]">
        <h2 class="m-0 font-serif text-[clamp(26px,2.8vw,34px)] font-medium">{nWord} plants, from Dioscorides' text to a 2050 map</h2>
        <p class="m-0 mt-1.5 text-muted">Sort by risk, filter by endemism or identification confidence, and open any plant for its source chapter, model and caveats.</p>
      </div>
      <a href={href('plants/')} class="btn-primary">Explore the plants</a>
    </div>
  </section>
</Base>
